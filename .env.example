# ============================================================
# E-commerce Support Agent configuration
# Copy this file to .env and fill in your own API key.
#   cp .env.example .env        (macOS / Linux)
#   copy .env.example .env      (Windows)
# Any OpenAI-compatible endpoint works. The system also runs
# WITHOUT a key (template replies + local hash embeddings).
# ============================================================

# ===== Basic =====
PROJECT_NAME=E-commerce Support Agent
VERSION=1.0.0

# ===== LLM (OpenAI-compatible) =====
LLM_API_KEY=sk-your-api-key-here
LLM_BASE_URL=https://api.siliconflow.cn/v1
# Any compatible chat model works, e.g. Qwen/Qwen2.5-7B-Instruct
# or deepseek-ai/DeepSeek-V4-Flash (the model used in development).
LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=1024

# ===== Embedding (RAG) =====
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
EMBEDDING_BATCH_SIZE=32

# ===== RAG =====
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.5

# ===== Agent =====
AGENT_NAME=小e
AGENT_MAX_ITERATIONS=5
AUTO_TRANSFER_SENTIMENT_THRESHOLD=-0.5

# ===== Intent recognition =====
INTENT_THRESHOLD=0.6